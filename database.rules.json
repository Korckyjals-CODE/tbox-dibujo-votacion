{
  "rules": {
    "meta": {
      ".read": true,
      ".write": true
    },
    "votes": {
      ".read": true,
      "$voteId": {
        ".write": "!data.exists() && root.child('meta/open').val() !== false",
        ".validate": "newData.hasChildren(['picks', 'fp', 'ts']) && newData.child('fp').isString() && newData.child('ts').isNumber() && newData.child('picks').hasChildren()"
      }
    }
  }
}
